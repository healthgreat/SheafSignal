{
  "name": "personal-content-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人内容 App：文章 + 视频 + 点赞 + 评论。uni-app + uniCloud，模块化架构。",
  "license": "MIT",
  "scripts": {
    "gen": "node scripts/gen-modules.mjs",
    "dev:h5": "npm run gen && uni",
    "dev:app": "npm run gen && uni -p app",
    "dev:mp-weixin": "npm run gen && uni -p mp-weixin",
    "build:h5": "npm run gen && uni build",
    "build:app": "npm run gen && uni build -p app",
    "build:mp-weixin": "npm run gen && uni build -p mp-weixin",
    "test": "node --import ./tests/setup/register-json.mjs --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020620260917001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vue/runtime-core": "^3.4.21",
    "rollup": "4.14.3",
    "vite": "5.2.8"
  },
  "engines": {
    "node": ">=18"
  }
}
