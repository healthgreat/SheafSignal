# Keep Docker build context limited to source, metadata, tests, and curated
# small benchmark summaries. Large matrices and generated archives are excluded.

.git/
.venv/
venv/
env/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
*.egg-info/

data/raw/
data/processed/
data/external/
release/archives/
results/
figures/
logs/

*.h5ad
*.h5
*.loom
*.rds
*.RData
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.vcf
*.vcf.gz
*.mtx
*.mtx.gz

manuscript/*.pdf
manuscript/*.docx
benchmarks/results/*/qc/*.pdf
benchmarks/results/*/stability/*.pdf
benchmarks/results/*/stratified/*.pdf
benchmarks/results/*/spatial/qc/*.pdf
